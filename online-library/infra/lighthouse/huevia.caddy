# Import from the existing /etc/caddy/Caddyfile; retain its other sites.
# DNS: huevia.cc A 118.24.164.117; inbound TCP 80 and 443 must be allowed.
(huevia_cloudbase) {
	# A fixed upstream avoids resolving huevia.cc back to this proxy.
	header X-Huevia-Edge "lighthouse-118.24.164.117"
	# Use the existing CloudBase custom-domain binding for browser navigation.
	reverse_proxy https://huevia.cc.tcbaccess.tencentcloudbase.com {
		header_up Host huevia.cc
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto https
		header_down Location "^https://nikon-d8girdjsr252fd90e-1252602548\\.ap-shanghai\\.app\\.tcloudbase\\.com(.*)$" "https://{http.request.host}${1}"
		transport http {
			tls_server_name huevia.cc
			dial_timeout 10s
			response_header_timeout 45s
		}
	}
}

huevia.cc {
	encode zstd gzip
	@old_admin path /preset-library/admin /preset-library/admin/*
	redir @old_admin https://admin.huevia.cc{uri} 302
	@library path /preset-library /preset-library/*
	handle @library {
		import huevia_cloudbase
	}
	handle {
		root * /var/www/huevia-home/current
		header X-Huevia-Site "product-home-20261107"
		header X-Content-Type-Options nosniff
		header Referrer-Policy strict-origin-when-cross-origin
		file_server
	}
}

admin.huevia.cc {
	# Host-only administrator cookies and the existing API prefix stay intact.
	@root path /
	redir @root /preset-library/admin/ 302
	import huevia_cloudbase
}
