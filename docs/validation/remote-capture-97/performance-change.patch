+    /** Yield between transactions, but do not throttle an original which is already ready. */
+    private long nextLiveWorkDelay(LiveRun run) {
+        long now = System.nanoTime();
+        if (!run.hints.isEmpty()) return 0;
+        for (LiveCandidate item : run.recent.values()) {
+            if (item.galleryRetry && !item.galleryPublishing) return 0;
+        }
+        for (LiveCandidate item : run.queue) {
+            if (run.unavailableStorages.contains(item.photo.storageId())) continue;
+            if (item.ready <= now) return 0;
+            break; // Preserve capture order and the existing busy retry deadline.
+        }
+        for (long handle : run.inspect) {
+            Long ready = run.metadataReady.get(handle);
+            if (ready == null || ready <= now) return 0;
+        }
+        return !run.inspect.isEmpty() || !run.queue.isEmpty() || !run.resumeReceipts.isEmpty() ? 250 : 3000;
+    }
