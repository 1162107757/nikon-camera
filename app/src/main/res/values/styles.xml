    <style name="DiagnosticTheme" parent="AppThemeDark">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#FFD43B</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">#101214</item>
        <item name="android:navigationBarColor">#101214</item>
        <item name="android:windowBackground">#101214</item>
    </style>
</resources>
